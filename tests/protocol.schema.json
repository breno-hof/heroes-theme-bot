{
  "client": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "type": {
            "type": "string",
            "const": "hello"
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "client": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "required": [
              "kind",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "v",
          "type",
          "token",
          "client"
        ],
        "additionalProperties": false
      }
    ]
  },
  "server": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "type": {
            "type": "string",
            "const": "welcome"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "serverVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "v",
          "type",
          "sessionId",
          "serverVersion"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "type": {
            "type": "string",
            "const": "voice.speaking"
          },
          "guildId": {
            "type": "string",
            "pattern": "^\\d{15,22}$"
          },
          "channelId": {
            "type": "string",
            "pattern": "^\\d{15,22}$"
          },
          "userId": {
            "type": "string",
            "pattern": "^\\d{15,22}$"
          },
          "speaking": {
            "type": "boolean"
          },
          "at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "v",
          "type",
          "guildId",
          "channelId",
          "userId",
          "speaking",
          "at"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "const": 1
          },
          "type": {
            "type": "string",
            "const": "error"
          },
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "unsupported_version",
              "bad_message",
              "handshake_timeout"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "v",
          "type",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    ]
  }
}
