# Copy to .env and fill in. Never commit the real file.

# Bot token from https://discord.com/developers/applications
HT_DISCORD_TOKEN=

# Guild and voice channel the bot joins on startup (enable Developer Mode, right-click, Copy ID)
HT_GUILD_ID=
HT_VOICE_CHANNEL_ID=

# Shared secret VTT clients present in their hello frame. Generate with: openssl rand -base64 32
HT_WS_TOKEN=

# Optional
# HT_WS_HOST=0.0.0.0
# HT_WS_PORT=8765
# JSON list of browser origins allowed to connect; unset allows any origin
# HT_WS_ALLOWED_ORIGINS=["https://foundry.example.com"]
# HT_SILENCE_TIMEOUT_MS=300
# HT_LOG_LEVEL=INFO
# HT_LOG_FORMAT=json
