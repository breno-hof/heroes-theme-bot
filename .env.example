# Copy to .env and fill in. Never commit the real file.

# Bot token from https://discord.com/developers/applications
HT_DISCORD_TOKEN=

# Everything else (voice channel, bridge token, allowed origins) is configured
# per Discord server with the /heroestheme command.

# Optional
# HT_DB_PATH=heroes-theme.db      (the Docker image defaults to /data/heroes-theme.db)
# HT_WS_HOST=0.0.0.0
# HT_WS_PORT=8765
# HT_SILENCE_TIMEOUT_MS=300
# HT_LOG_LEVEL=INFO
# HT_LOG_FORMAT=json
